# Copy to deploy/.env and fill every value. Never commit deploy/.env.
DOMAIN=class.your-domain.example
MYSQL_DATABASE=classroom_pulse
MYSQL_USER=classpulse
MYSQL_PASSWORD=replace-with-random-database-password
MYSQL_ROOT_PASSWORD=replace-with-random-root-password
JWT_SECRET=replace-with-at-least-32-random-bytes-base64-or-text

# One-time production teacher bootstrap. Set both values, start once, then remove
# the password from the environment. The account remains in MySQL.
BOOTSTRAP_TEACHER_USERNAME=admin
BOOTSTRAP_TEACHER_PASSWORD=
BOOTSTRAP_TEACHER_NAME=教师

# Independent admin console bootstrap. Use a different strong password.
# Remove BOOTSTRAP_ADMIN_PASSWORD after the first successful start.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=系统管理员
ADMIN_SESSION_HOURS=8

# Optional CORS origins for a browser client, comma separated.
CORS_ALLOWED_ORIGINS=
